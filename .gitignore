# Game data — user-supplied, never committed (copyrighted ROM dumps + decryption key)
rom/
*.key
*.zip

# Runtime state files
state*.bin
*.state

# OS / editor junk
.DS_Store
Thumbs.db
__pycache__/
*.err
*.out

# Build intermediates are excluded; the prebuilt executable
# (cps2recomp/build/ddsom/ddsom.exe) is force-added explicitly.
build/

# work/ (generated recompiled C++) is intentionally tracked.
